DATABASE_URL="********************************/cooklink"
# Deployment migrations use a separate role with DDL privileges. The running
# application continues to use the restricted DATABASE_URL role.
# MIGRATION_DATABASE_URL="postgresql://migration-role:password@host/postgres?sslmode=require"
CLERK_SECRET_KEY="sk_test_..."
CLERK_PUBLISHABLE_KEY="pk_test_..."
PORT="3000"
# Externally reachable API origin used for the Swiggy OAuth callback. Local
# development may use http://localhost:3000; production must be HTTPS.
COOKLINK_PUBLIC_API_URL="http://localhost:3000"

# Set to "true" when connecting through PlanetScale's PgBouncer port (6432).
# Disables prepared statements for compatibility with transaction-mode pooling.
PGBOUNCER="false"
# Keep total connections across all replicas within the database plan limit.
DB_POOL_MAX="10"
DB_CONNECT_TIMEOUT_MS="5000"
DB_IDLE_TIMEOUT_MS="30000"

# Optional error capture. Required by the V1 production-readiness checklist.
SENTRY_DSN=""
SENTRY_RELEASE=""

# Local development only. When true, the API accepts x-clerk-user-id headers
# so the seeded demo users can be exercised without a real Clerk session.
COOKLINK_DEV_AUTH="false"

# Issue 11 — real Instamart ordering is visibly feature-gated until Swiggy
# grants staging and production access. When false, the checkout surface
# renders but declines to place; when true, eligible carts may check out.
# The server refuses to start with COOKLINK_ORDERING_ENABLED=true while
# COOKLINK_SWIGGY_MODE=stub: a live deployment must never silently fall back
# to the stub provider. Keep both false/stub for an explicitly stub deployment.
COOKLINK_ORDERING_ENABLED="false"

# Swiggy provider transport. `stub` keeps local deterministic fixtures;
# `staging` and `production` use the real Instamart MCP endpoint. Anything
# other than stub requires SWIGGY_TOKEN_ENCRYPTION_KEY below; the server
# validates this at startup and fails fast with an actionable error.
# NODE_ENV=production deployments MUST set this explicitly — the stub default
# applies only to development and preview environments.
COOKLINK_SWIGGY_MODE="stub"
# Optional endpoint override for partner-specific staging environments.
SWIGGY_MCP_BASE_URL="https://mcp-staging.swiggy.com"
# Generate with: openssl rand -base64 32
SWIGGY_TOKEN_ENCRYPTION_KEY="base64-encoded-32-byte-key"
