{
  "name": "cooklink",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Cooklink — meal planning, cooking, and grocery replenishment for one household and its hired cook.",
  "packageManager": "pnpm@10.15.1",
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "test": "pnpm -r --if-present test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev:server": "pnpm --filter @cooklink/server dev",
    "dev:mobile": "pnpm --filter @cooklink/mobile start",
    "db:generate": "pnpm --filter @cooklink/db generate",
    "db:migrate": "pnpm --filter @cooklink/db migrate",
    "db:seed": "pnpm --filter @cooklink/db seed",
    "secrets:check": "pnpm --filter @cooklink/server secrets:check",
    "secrets:grep": "pnpm --filter @cooklink/server secrets:grep"
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "eslint": "^9.14.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.13.0"
  },
  "engines": {
    "node": ">=20"
  }
}
